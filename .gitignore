# macOS
.DS_Store

# Editor / tool config
.kiro/

# Temporary files
tmp/

# Personal profile (use starter-kit/profile.md as template)
/profile.md

# Personal content — keep structure (.gitkeep) but exclude actual entries
daily-tasks/**/*.md
!daily-tasks/.gitkeep

projects/working-on/*/
!projects/working-on/.gitkeep

projects/finished/*/
!projects/finished/.gitkeep

people/*.md
!people/.gitkeep

personal-workflows/interactions/*.md
!personal-workflows/interactions/.gitkeep

personal-workflows/mr-reviews/*.md
!personal-workflows/mr-reviews/.gitkeep

personal-workflows/performance-review/

# Skills — only example template is tracked; personal skills stay local
skills/*/
!skills/example/

# PNG screenshots (temp testing artifacts)
*.png
!icons/*.png
!poster.png

# Playwright MCP artifacts
.playwright-mcp/

# Scripts — setup and inject scripts are tracked; personal/generated scripts stay local
scripts/*
!scripts/setup-claude-skills.sh
!scripts/inject-profile.sh
